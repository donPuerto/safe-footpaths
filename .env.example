# Safe Footpaths web page — only what the page itself reads.
# Copy to .env locally; on Vercel set the same keys with `vercel env add` (scope: don-puertos-projects-52759984).
# Full project list of settings: ../.env.example

# n8n webhooks (Don's own server, never ConnachtGroup)
N8N_WEBHOOK_BASE=https://n8n-3p72.srv1966992.hstgr.cloud/webhook
# Sent as header x-sf-key; must match the n8n Header Auth credential "SF web key"
N8N_WEBHOOK_KEY=

# Passcode for Move / Lock (viewing needs none)
APP_PASSCODE=

# Shown as "Open the Google Sheet" link on the page (not secret)
NUXT_PUBLIC_SHEET_URL=
